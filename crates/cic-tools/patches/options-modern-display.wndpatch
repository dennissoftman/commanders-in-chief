# Commanders in Chief
# Copyright (C) 2026 Commanders in Chief contributors
# SPDX-License-Identifier: GPL-3.0-only
#
# Modern display controls for the retail Options menu.
#
# The original's display API is `Display.h`'s
# `setDisplayMode( width, height, bitDepth, windowed )`: a resolution, a bit depth, and one
# windowed boolean. It has no monitor selector, no borderless mode, no refresh rate at all, and no
# UI scale independent of render resolution. This patch adds those four as project-owned controls
# without touching one byte of the user's WND.
#
# The stock `ComboBoxResolution` is deliberately reused rather than replaced — it is the one display
# control the original already has, and it stays exactly where the layout puts it. The four inserted
# controls carry the same appearance records the stock combo declares, so they name the user's own
# installed mapped images and read as part of the menu rather than as something bolted on. No art is
# carried here; every `IMAGE:` below is a name resolved through the VFS at run time.
#
# Geometry is in creation-resolution coordinates. There is no free space on the main Options page —
# the 800x600 canvas is full, and the controls retail authored past x=800 are off-screen at every
# Classic-scaled viewport — so the settings go where retail itself reserved room for them.
#
# The four inserted labels carry literal text rather than a CSF label, because no shipped string
# table defines a name for a control the original does not have. Localizing project-owned labels
# needs a project-owned string table, which does not exist yet; a WND TEXT record holds either a
# label or a literal, so this is the format's own answer rather than a workaround.
#
# Generated once from the stock control; edit the generator rather than this file if the shape of
# an inserted control needs to change.

version 1
target Window/Menus/OptionsMenu.wnd

# Refuse to apply against a layout that is not the one this geometry was authored for.
require-window "OptionsMenu.wnd:WinAdvancedDisplayOptions"
require-window "OptionsMenu.wnd:LowResWin"
require-window "OptionsMenu.wnd:ParticleCapWin"
require-window "OptionsMenu.wnd:ComboBoxResolution"
require-window "OptionsMenu.wnd:ResolutionLabel"
require-field  "OptionsMenu.wnd:ComboBoxResolution" STYLE "MOUSETRACK+COMBOBOX"

# Retail already reserved a full-size panel for advanced display settings and ships it hidden. That
# is where these controls belong, and showing it is a visible STATUS edit rather than a new window.
require-field "OptionsMenu.wnd:WinAdvancedDisplayOptions" STATUS "ENABLED+HIDDEN"
set-field     "OptionsMenu.wnd:WinAdvancedDisplayOptions" STATUS "ENABLED"

# Two legacy sub-panels are hidden to make room: a low-resolution-texture slider and a particle cap,
# both of which set fixed-function limits this renderer does not have. Hiding is a STATUS edit, so
# the windows and every field they declare survive in the patched document and a different profile
# can leave them alone.
set-field "OptionsMenu.wnd:LowResWin" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:ParticleCapWin" STATUS "ENABLED+HIDDEN"

# The stock resolution control is reused rather than replaced — it is the one display control the
# original already has — and moved into the panel so the complete display settings read as one
# group. Its tooltip delay is rewritten too, which shows an overlay reaching an established field.
require-field "OptionsMenu.wnd:ComboBoxResolution" TOOLTIPDELAY "-1"
set-field     "OptionsMenu.wnd:ComboBoxResolution" TOOLTIPDELAY "250"
reparent      "OptionsMenu.wnd:ResolutionLabel" "OptionsMenu.wnd:WinAdvancedDisplayOptions" 0
reparent      "OptionsMenu.wnd:ComboBoxResolution" "OptionsMenu.wnd:WinAdvancedDisplayOptions" 1
set-rect      "OptionsMenu.wnd:ResolutionLabel" 165 312 390 330 800 600
set-rect      "OptionsMenu.wnd:ComboBoxResolution" 165 331 390 355 800 600


# Hide the main page while the advanced panel is up.
set-field "OptionsMenu.wnd:ButtonBack" STATUS "ENABLED+IMAGE+HIDDEN"
set-field "OptionsMenu.wnd:ButtonAccept" STATUS "ENABLED+IMAGE+HIDDEN"
set-field "OptionsMenu.wnd:ButtonDefaults" STATUS "ENABLED+IMAGE+HIDDEN"
set-field "OptionsMenu.wnd:NetworkParent" STATUS "ENABLED+NOFOCUS+HIDDEN"
set-field "OptionsMenu.wnd:VideoParent" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:ScrollParent" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:AudioParent" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:SliderMusicVolume" STATUS "ENABLED+IMAGE+TABSTOP+HIDDEN"
set-field "OptionsMenu.wnd:SliderSFXVolume" STATUS "ENABLED+IMAGE+TABSTOP+HIDDEN"
set-field "OptionsMenu.wnd:Line2" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:Line3" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:Line4" STATUS "ENABLED+HIDDEN"
set-field "OptionsMenu.wnd:Line1" STATUS "ENABLED+HIDDEN"
insert-window "OptionsMenu.wnd:WinAdvancedDisplayOptions" 0
WINDOW
  WINDOWTYPE = USER;
  SCREENRECT = UPPERLEFT: 647 200,
               BOTTOMRIGHT: 935 470,
               CREATIONRESOLUTION: 800 600;
  NAME = "OptionsMenu.wnd:CicDisplayParent";
  STATUS = ENABLED+SEE_THRU;
CHILD
WINDOW
  WINDOWTYPE = STATICTEXT;
  SCREENRECT = UPPERLEFT: 400 312,
               BOTTOMRIGHT: 625 330,
               CREATIONRESOLUTION: 800 600;
  NAME = "OptionsMenu.wnd:StaticTextMonitor";
  STATUS = ENABLED+IMAGE;
  TEXT = "Monitor";
  STYLE = STATICTEXT+MOUSETRACK;
  SYSTEMCALLBACK = "[None]";
  INPUTCALLBACK = "[None]";
  TOOLTIPCALLBACK = "[None]";
  DRAWCALLBACK = "[None]";
  FONT = NAME: "Arial", SIZE: 14, BOLD: 0;
  HEADERTEMPLATE = "MinorTitle";
  TOOLTIPDELAY = -1;
  TEXTCOLOR = ENABLED: 255 255 255 255, ENABLEDBORDER: 0 0 0 255, DISABLED: 192 192 192 255, DISABLEDBORDER: 64 64 64 255, HILITE: 128 128 255 255, HILITEBORDER: 0 0 128 255;
  ENABLEDDRAWDATA = IMAGE: NoImage, COLOR: 0 0 0 0, BORDERCOLOR: 0 0 0 0, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255;
  DISABLEDDRAWDATA = IMAGE: NoImage, COLOR: 64 64 64 255, BORDERCOLOR: 192 192 192 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255;
  HILITEDRAWDATA = IMAGE: NoImage, COLOR: 0 128 0 255, BORDERCOLOR: 128 255 128 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255, IMAGE: NoImage, COLOR: 255 255 255 255, BORDERCOLOR: 255 255 255 255;
  STATICTEXTDATA = CENTERED: 0;
END
WINDOW
  WINDOWTYPE = COMBOBOX;
  SCREENRECT = UPPERLEFT: 400 331,
               BOTTOMRIGHT: 625 355,
               CREATIONRESOLUTION: 800 600;
  NAME = "OptionsMenu.wnd:ComboBoxMonitor";
  STATUS = ENABLED+IMAGE;
  STYLE = MOUSETRACK+COMBOBOX;
  SYSTEMCALLBACK = "[None]";
  INPUTCALLBACK = "[None]";
  TOOLTIPCALLBACK = "[None]";
  DRAWCALLBACK = "[None]";
  FONT = NAME: "Arial", SIZE: 10, BOLD: 0;
  HEADERTEMPLATE = "ComboBoxEntry";
  TOOLTIPDELAY = -1;
  TEXTCOLOR = ENABLED: 254 254 254 255, ENABLEDBORDER: 0 0 0 255, DISABLED: 192 192 192 255, DISABLEDBORDER: 64 64 64 255, HILITE: 128 128 255 255, HILITEBORDER: 0 0 128 255;
  ENABLEDDRAWDATA = IMAGE: BlackSquare, COLOR: 255 0 0 255, BORDERCOLOR: 255 128 128 255, IMAGE: ListBoxHiliteItemLeftEnd, COLOR: 255 255 0 255, BORDERCOLOR: 254 254 254 255, IMAGE: ListBoxHiliteItemRightEnd, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: ListBoxHiliteItemRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: ListBoxHiliteItemSmallRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  DISABLEDDRAWDATA = IMAGE: NoImage, COLOR: 128 128 128 255, BORDERCOLOR: 192 192 192 255, IMAGE: NoImage, COLOR: 192 192 192 255, BORDERCOLOR: 254 254 254 255, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  HILITEDRAWDATA = IMAGE: NoImage, COLOR: 0 255 0 255, BORDERCOLOR: 0 128 0 255, IMAGE: ListBoxHiliteSelectedItemLeftEnd, COLOR: 254 254 254 255, BORDERCOLOR: 0 128 0 255, IMAGE: ListBoxHiliteSelectedItemRightEnd, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: ListBoxHiliteSelectedItemRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: ListBoxHiliteSelectedItemSmallRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  COMBOBOXDATA = ISEDITABLE: 0, MAXCHARS: 16, MAXDISPLAY: 5, ASCIIONLY: 0, LETTERSANDNUMBERS: 0;
  COMBOBOXDROPDOWNBUTTONENABLEDDRAWDATA = IMAGE: VSliderDownButtonEnabled, COLOR: 255 0 0 255, BORDERCOLOR: 255 128 128 255, IMAGE: VSliderDownButtonHiliteSelected, COLOR: 255 255 0 255, BORDERCOLOR: 254 254 254 255, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  COMBOBOXDROPDOWNBUTTONDISABLEDDRAWDATA = IMAGE: VSliderDownButtonDisabled, COLOR: 128 128 128 255, BORDERCOLOR: 192 192 192 255, IMAGE: NoImage, COLOR: 192 192 192 255, BORDERCOLOR: 128 128 128 255, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  COMBOBOXDROPDOWNBUTTONHILITEDRAWDATA = IMAGE: VSliderDownButtonHilite, COLOR: 0 255 0 255, BORDERCOLOR: 0 128 0 255, IMAGE: VSliderDownButtonHiliteSelected, COLOR: 255 255 0 255, BORDERCOLOR: 254 254 254 255, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  COMBOBOXEDITBOXENABLEDDRAWDATA = IMAGE: TextEntryEnabledLeftEnd, COLOR: 255 0 0 255, BORDERCOLOR: 255 128 128 255, IMAGE: TextEntryEnabledRightEnd, COLOR: 255 255 0 255, BORDERCOLOR: 254 254 254 255, IMAGE: TextEntryEnabledRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: TextEntryEnabledSmallRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  COMBOBOXEDITBOXDISABLEDDRAWDATA = IMAGE: TextEntryDisabledLeftEnd, COLOR: 128 128 128 255, BORDERCOLOR: 0 0 0 255, IMAGE: TextEntryDisabledRightEnd, COLOR: 192 192 192 255, BORDERCOLOR: 254 254 254 255, IMAGE: TextEntryDisabledRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: TextEntryDisabledSmallRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
  COMBOBOXEDITBOXHILITEDRAWDATA = IMAGE: TextEntryHiliteLeftEnd, COLOR: 0 255 0 255, BORDERCOLOR: 0 128 0 255, IMAGE: TextEntryHiliteRightEnd, COLOR: 254 254 254 255, BORDERCOLOR: 0 128 0 255, IMAGE: TextEntryHiliteRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: TextEntryHiliteSmallRepeatingCenter, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0, IMAGE: NoImage, COLOR: 255 255 255 0, BORDERCOLOR: 255 255 255 0;
