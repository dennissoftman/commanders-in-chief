                "children": [
                  { "widget": "label", "text_key": "skirmish.map_ridge", "height": { "fixed": 26.0 } },
                  { "widget": "label", "text_key": "skirmish.map_basin", "height": { "fixed": 26.0 } },
                  { "widget": "label", "text_key": "skirmish.map_delta", "height": { "fixed": 26.0 } }
                ]
              }
            ]
